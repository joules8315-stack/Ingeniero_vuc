        _ruta = sys.argv[3] if len(sys.argv) >= 4 else os.path.join(AQUI, "memoria", "ULTIMO_TRABAJO_DEL_EQUIPO.json")
        if not os.path.exists(_ruta):
            print("NO_ENCONTRADO: no hay ningun trabajo del equipo guardado.")
