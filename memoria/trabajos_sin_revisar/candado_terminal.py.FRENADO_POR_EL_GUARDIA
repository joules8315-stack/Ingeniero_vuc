                    "  se leyo con el arnes APAGADO: " + texto[:150] + "\n")
    except Exception:
        pass


def main():
    import autorizacion
    if autorizacion.autorizada():  # F7: solo Julio apaga, por comando autorizar-off (con autorizacion)
