# Reglas de ordenes de Codex en el equipo de Julio (acuerdo A-40, 2026-09-21).
#
# Antes habia 23 autorizaciones de antemano ("allow") que venian de cuando Codex trabajaba en
# Foto Informe. Medido el 2026-09-21: con Codex en solo lectura, una orden autorizada de antemano
# ("git add -A") SE EJECUTO IGUAL y escribio en el guardado. Una autorizacion vieja se saltaba
# el candado. Se quitaron todas; el respaldo esta en
#   C:\Ingeniero_VUC\memoria\rescate\codex_2026-09-21\default.rules
#
# Codex NO guarda, NO deshace y NO mueve trabajo en la historia: eso lo hace el programa del
# Ingeniero, despues de la revision del equipo y con el guardia de guardado delante.

# LO UNICO QUE PUEDE HACER CODEX FUERA DE SOLO LECTURA: darle la orden al equipo del Ingeniero,
# igual que Claude. No escribe codigo: el trabajo lo escribe DeepSeek, lo revisa otro de otra casa
# y lo guarda el guardia. Nada mas queda autorizado de antemano.
prefix_rule(pattern=["python", "ingeniero.py", "arranca"], decision="allow")
prefix_rule(pattern=["python", "ingeniero.py", "trabaja"], decision="allow")
prefix_rule(pattern=["python", "ingeniero.py", "equipo"], decision="allow")
prefix_rule(pattern=["python", "ingeniero.py", "pit"], decision="allow")

prefix_rule(pattern=["git", "add"], decision="forbidden")
prefix_rule(pattern=["git", "commit"], decision="forbidden")
prefix_rule(pattern=["git", "push"], decision="forbidden")
prefix_rule(pattern=["git", "reset"], decision="forbidden")
prefix_rule(pattern=["git", "restore"], decision="forbidden")
prefix_rule(pattern=["git", "checkout"], decision="forbidden")
prefix_rule(pattern=["git", "switch"], decision="forbidden")
prefix_rule(pattern=["git", "rm"], decision="forbidden")
prefix_rule(pattern=["git", "mv"], decision="forbidden")
prefix_rule(pattern=["git", "stash"], decision="forbidden")
prefix_rule(pattern=["git", "rebase"], decision="forbidden")
prefix_rule(pattern=["git", "merge"], decision="forbidden")
prefix_rule(pattern=["git", "cherry-pick"], decision="forbidden")
prefix_rule(pattern=["git", "clean"], decision="forbidden")
