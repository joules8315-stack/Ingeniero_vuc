{
  "env": {
    "INGENIERO_QUIEN": "claude"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(python ingeniero.py *)",
      "Bash(python arnes/canal.py *)",
      "Bash(python arnes/candado_legislar.py *)",
      "Bash(python arnes/instalar.py *)",
      "Bash(python -m pytest *)",
      "Bash(python -c *)",
      "Bash(python -m py_compile *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git ls-files *)",
      "Bash(git rm --cached *)",
      "Bash(git check-ignore *)",
      "Bash(git rev-parse *)",
      "Bash(sed -n *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(du *)",
      "Bash(cp *)",
      "Bash(date *)",
      "Bash(echo *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/candado_legislar.py\" desde-julio"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/candado_buzon.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/modo_ingeniero.py\" prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/candado_ancla.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/candado_por_nombre.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/candado_companero.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/candado_ruta_de_acceso.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/candado_gasto.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/candado_comunicacion.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/candado_supervisor.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/candado_no_repetir.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/candado_commit.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/arnes/candado_buzon.py\""
          }
        ]
      }
    ]
  }
}
