{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "* > *": "deny",
      "*>>*": "deny",
      "rm *": "deny",
      "del *": "deny",
      "rmdir *": "deny",
      "mv *": "deny",
      "move *": "deny",
      "cp *": "deny",
      "copy *": "deny",
      "tee *": "deny",
      "*| tee*": "deny",
      "mkdir *": "deny",
      "touch *": "deny",
      "sed -i*": "deny",
      "git add*": "deny",
      "git commit*": "deny",
      "git checkout*": "deny",
      "git reset*": "deny",
      "git restore*": "deny",
      "git stash*": "deny",
      "git rm*": "deny",
      "git mv*": "deny",
      "Set-Content*": "deny",
      "Out-File*": "deny",
      "New-Item*": "deny",
      "Remove-Item*": "deny"
    }
  }
}
