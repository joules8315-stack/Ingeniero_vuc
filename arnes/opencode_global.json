{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "ls*": "allow",
      "dir*": "allow",
      "cat *": "allow",
      "type *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "wc *": "allow",
      "Get-Content*": "allow",
      "Select-String*": "allow",
      "Get-ChildItem*": "allow",
      "python -m pytest*": "allow",
      "*python -c*": "deny",
      "*python3 -c*": "deny",
      "*node -e*": "deny",
      "*powershell*": "deny",
      "*pwsh*": "deny",
      "*cmd /c*": "deny",
      "*&&*": "deny",
      "*open(*": "deny",
      "* > *": "deny",
      "*>>*": "deny",
      "git add*": "deny",
      "git commit*": "deny",
      "git checkout*": "deny",
      "git reset*": "deny",
      "git restore*": "deny",
      "git stash*": "deny",
      "rm *": "deny",
      "mv *": "deny",
      "cp *": "deny"
    }
  }
}
