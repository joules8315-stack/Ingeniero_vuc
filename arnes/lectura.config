# lectura.config — que tan duro es el candado de lectura.
# tope_lineas    : por debajo de esto se lee libre (no estorbar por gusto)
# vigencia_horas : cuanto vale un paquete antes de considerarse rancio
# libres         : extensiones que nunca se bloquean (documentos, config)
tope_lineas=300
vigencia_horas=8
libres=.md,.config,.json,.txt,.sql,.env,.example
